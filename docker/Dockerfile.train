# Training image for VastAI — CUDA 12.1 + PyTorch 2.2
FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-devel

WORKDIR /workspace

# System deps
RUN apt-get update && apt-get install -y \
    git curl wget unzip \
    libglib2.0-0 libsm6 libxrender1 libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements/base.txt requirements/training.txt ./requirements/
RUN pip install --no-cache-dir \
    -r requirements/base.txt \
    -r requirements/training.txt

# Install project
COPY . .
RUN pip install --no-cache-dir -e ".[training,segmentation]"

# HuggingFace cache → persistent volume on VastAI
ENV HF_HOME=/workspace/.cache/huggingface
ENV TRANSFORMERS_CACHE=/workspace/.cache/huggingface

CMD ["bash"]
