# HuggingFace — required for MedGemma access
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modal — endpoint URLs from `modal deploy serving/modal/app.py`
MODAL_ENDPOINT_URL=https://<your-modal-username>--ai-medical-dept-medicalinference-infer.modal.run
MODAL_PIPELINE_URL=https://<your-modal-username>--ai-medical-dept-medicalinference-infer-batch.modal.run

# AWS — S3 bucket for storing DICOM raw files + CT slice images
S3_BUCKET_NAME=your-bucket-name
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# RDS PostgreSQL — structured storage cho clinical records + consultation reports
# (xem db/schema.sql)
DB_HOST=your-db-host.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres

# Highlighter — annotate các cụm từ quan trọng trong free-text report (text-only)
# Đổi nhà cung cấp: chỉ cần đổi HIGHLIGHTER_PROVIDER + key tương ứng, không cần sửa code.
HIGHLIGHTER_PROVIDER=groq
# HIGHLIGHTER_MODEL=openai/gpt-oss-120b   # mặc định nếu không set

# Groq — free, lấy key tại https://console.groq.com/keys (không cần thẻ)
# Lưu ý: Groq chặn theo IP/region của 1 số VPS cloud (403 Forbidden) dù key hợp lệ.
GROQ_API_KEY=

# OpenRouter — fallback provider (set HIGHLIGHTER_PROVIDER=openrouter để dùng)
# Free, lấy key tại https://openrouter.ai/keys (không cần thẻ)
OPENROUTER_API_KEY=

# DeepSeek — fallback provider (set HIGHLIGHTER_PROVIDER=deepseek để dùng)
# Rẻ, lấy key tại https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Gemini — fallback provider (set HIGHLIGHTER_PROVIDER=gemini để dùng)
GOOGLE_API_KEY=

# Anthropic — fallback provider (set HIGHLIGHTER_PROVIDER=anthropic để dùng)
ANTHROPIC_API_KEY=

# OpenAI — fallback provider (set HIGHLIGHTER_PROVIDER=openai để dùng)
OPENAI_API_KEY=
