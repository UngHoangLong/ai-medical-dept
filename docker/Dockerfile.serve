# Serving image for VastAI — lighter than training image
FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime

WORKDIR /workspace

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY requirements/base.txt requirements/serving.txt ./requirements/
RUN pip install --no-cache-dir \
    -r requirements/base.txt \
    -r requirements/serving.txt

COPY . .
RUN pip install --no-cache-dir -e ".[serving]"

ENV HF_HOME=/workspace/.cache/huggingface
ENV API_HOST=0.0.0.0
ENV API_PORT=8000

EXPOSE 8000

CMD ["uvicorn", "serving.server:app", "--host", "0.0.0.0", "--port", "8000"]
